{
  "manifest_version": 3,
  "name": "Job Application Tracker",
  "version": "0.1.0",
  "description": "Track your job applications: capture postings, follow status, and keep notes — all stored locally in your browser.",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/keywords.js", "content/detect.js"],
      "run_at": "document_idle"
    }
  ]
}
